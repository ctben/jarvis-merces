# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  copy .env.example .env

# ── จำเป็น ─────────────────────────────────────────────────
# คีย์ของ TypeSafe (โมเดล Jev ตัวตัดสินใจ) ขอได้ที่ https://typesafe.ai
TYPESAFE_API_KEY=

# ── สมองส่วนคุย (ตอบคำถาม/สรุปเว็บ) ────────────────────────
# LLM_MODE: auto = ใช้คีย์คลาวด์ถ้ามี ไม่งั้นลองใช้ Ollama ในเครื่อง (ถ้าติดตั้งไว้)
#           cloud = ใช้คีย์คลาวด์เท่านั้น · local = ใช้ Ollama เท่านั้น · off = คุยเล่นแบบสำเร็จรูปเท่านั้น
LLM_MODE=auto
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# โมเดลคลาวด์ เว้นว่าง = ค่าเริ่มต้น (OpenRouter: anthropic/claude-haiku-4.5, Google: gemini-2.5-flash-lite)
LLM_MODEL=
# โมเดลของ Ollama ในเครื่อง (แนะนำ qwen2.5 กับภาษาไทย — ollama pull qwen2.5:3b)
OLLAMA_MODEL=qwen2.5:3b

# ── ตัวตัดสินใจ Jev ────────────────────────────────────────
JEV_MODEL=jev-latest
# ความมั่นใจขั้นต่ำ (0-1) ต่ำกว่านี้จะขอให้พูดใหม่
CONF_MIN=0.65

# ── เสียงพูด ──────────────────────────────────────────────
# เสียง Edge TTS (th-TH-NiwatNeural = ผู้ชาย, th-TH-AcharaNeural = ผู้หญิง)
TTS_VOICE=th-TH-NiwatNeural
# ความเร็ว/โทนเสียง เช่น +15% / -10Hz
TTS_RATE=+15%
TTS_PITCH=+0Hz

# ── การฟังและการคุย ──────────────────────────────────────
# คำปลุก: ต้องเรียกชื่อนี้ก่อนสั่ง (คั่นหลายคำด้วย ,) ใส่ off = ฟังทุกประโยคโดยไม่ต้องเรียกชื่อ
WAKE_WORD=จาร์วิส
# หลังคุยกันแล้ว คุยต่อได้กี่วินาทีโดยไม่ต้องเรียกชื่อซ้ำ
CONVO_SEC=30
# การพูดแทรกตอนจาร์วิสกำลังพูด: แนะนำ on เฉพาะเวลาใส่หูฟัง (ลำโพงเสียงดังอาจไปปลุกตัวเอง)
BARGE_IN=off
# ความเงียบกี่มิลลิวินาทีถึงถือว่าจบประโยค (น้อย = ตอบไว แต่อาจตัดกลางประโยค)
SILENCE_MS=650
# ความไวการฟังเสียงคน (0.004 - 0.05 ห้องเสียงดังให้เพิ่มขึ้น)
ENERGY_MULT=3.0
# เลือกไมค์/ลำโพงตามหมายเลขจาก selftest (เว้นว่าง = อุปกรณ์เริ่มต้น)
MIC_DEVICE=
SPK_DEVICE=

# ── ถอดเสียง ─────────────────────────────────────────────
# โมเดล faster-whisper: tiny(เร็วสุด) / base / small(แนะนำ) / medium(แม่สุด-ช้า)
# ครั้งแรกดาวน์โหลดโมเดลเอง (small ≈ 460 MB)
WHISPER_MODEL=small
# ใส่ชื่อโฟลเดอร์เพื่อเก็บเสียงแต่ละประโยคเป็น WAV ไว้ทดสอบ (เว้นว่าง = ไม่เก็บ)
SAVE_UTTERANCES=
# ข้อความที่ได้ยินแต่ไม่ได้เรียกชื่อ: เว้นว่าง = บอกแค่ความยาว · all = พิมพ์ข้อความด้วย (ไว้ดีบัก)
LOG_HEARD=

# ── เว็บเบราว์เซอร์ ──────────────────────────────────────
# ใช้เบราว์เซอร์ไหนเปิดผลค้นหา: chrome / edge / default
BROWSER=chrome
# ให้ Chrome เปิดโปรไฟล์ที่ต้องการ (ชื่อเช่น Default, Profile 1) เว้นว่าง = โปรไฟล์ที่ใช้ล่าสุด
CHROME_PROFILE=

# ── หน้าจอ ────────────────────────────────────────────────
# วงกลม J.A.R.V.I.S ลอยบนจอ: on / off
HUD=on

# ── อื่นๆ ─────────────────────────────────────────────────
# on = ไม่สั่งเครื่องจริง แค่พิมพ์ว่าจะทำอะไร (ไว้ทดสอบ)
DRY_RUN=off
